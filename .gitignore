# ------------------------------------------------------------------------------
# SmartLearn.AI Root .gitignore
# ------------------------------------------------------------------------------

# Environment variables and local secrets
.env
.env.*
!.env.example
!*.env.example

# Python byte-code & caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging & distribution
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing, typing, and linting caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node & Frontend (monorepo root protection)
node_modules/
dist/
*.local

# Database artifacts
*.sqlite3
*.db

# IDE and OS metadata
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
