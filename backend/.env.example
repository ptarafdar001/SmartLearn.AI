# ------------------------------------------------------------------------------
# SmartLearn.AI Backend Environment Configuration Template
# Duplicate this file to .env and configure with local secrets.
# NEVER commit .env to version control.
# ------------------------------------------------------------------------------

# Application Settings
PROJECT_NAME="SmartLearn.AI API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (JSON array format)
ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:5173"]'

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_DB="smartlearn"

# Direct SQLAlchemy Database URL (constructed from above if not set)
DATABASE_URL="postgresql://postgres:your_postgres_password_here@localhost:5432/smartlearn"

# Security & JWT Authentication
SECRET_KEY="replace_with_a_secure_random_secret_key_minimum_32_characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Tutor Configuration & Multi-Provider Failover
# Primary Provider: Google Gemini (Get key at: https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"
AI_TUTOR_MODEL="gemini-3.6-flash"
AI_TUTOR_TIMEOUT_SECONDS=30

# Optional Fallback Provider: Groq (Get key at: https://console.groq.com/)
# Free Tier: 30 RPM, generous daily request/token ceilings, sub-second LPU inference.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_VISION_MODEL="llama-3.2-11b-vision-preview"

# Optional Fallback Provider: OpenRouter (Get key at: https://openrouter.ai/)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"

# Optional Fallback Provider: Cerebras (Get key at: https://cloud.cerebras.ai/)
CEREBRAS_API_KEY=""
CEREBRAS_MODEL="llama-3.3-70b"

# Optional Fallback Provider: Mistral (Get key at: https://console.mistral.ai/)
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"

# Provider Resolution Order (comma-separated priority list)
AI_TUTOR_PROVIDER_ORDER="gemini,groq,openrouter,cerebras,mistral"
